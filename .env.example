# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/rideio

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=15m
REFRESH_SECRET=your_refresh_secret_here
REFRESH_EXPIRY=7d

# Security
BCRYPT_SALT_ROUNDS=your_salt_rounds

# URLs
FRONTEND_URL=http://localhost:5173

# File Uploads (add when implementing)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (add when implementing)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=

# Admin (required for seed script)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Payments (add when implementing)
# SSL_STORE_ID=
# SSL_STORE_PASSWORD=