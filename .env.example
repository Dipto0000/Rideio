# Server
PORT=5000
NODE_ENV=development

# Database
DB_URL=mongodb://localhost:27017/rideio

# JWT Authentication
JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES=30d
JWT_VERIFICATION_SECRET=your_verification_secret_here

# Security
BCRYPT_SALT_ROUND=10

# URLs
# ── Local Development ──
FRONTEND_URL=http://localhost:3000
# ── Production (Vercel) — use this in Vercel dashboard ──
# FRONTEND_URL=https://rideio.vercel.app

# Backend URL (used by the frontend)
# Local: http://localhost:5000
# Production (Vercel): https://rideio-backend.vercel.app

# Gmail SMTP (for email delivery)
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address and the 16-char app password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM_NAME=Rideio Team
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SSLCommerz (for payments)
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_SANDBOX=true
# ── Local Development URLs ──
SSL_SUCCESS_URL=http://localhost:5000/api/v1/subscriptions/success
SSL_CANCEL_URL=http://localhost:5000/api/v1/subscriptions/cancel
SSL_FAIL_URL=http://localhost:5000/api/v1/subscriptions/fail
SSL_IPN_URL=http://localhost:5000/api/v1/subscriptions/ipn
# ── Production (Vercel) — use these in Vercel dashboard env vars ──
# SSL_SUCCESS_URL=https://rideio-backend.vercel.app/api/v1/subscriptions/success
# SSL_CANCEL_URL=https://rideio-backend.vercel.app/api/v1/subscriptions/cancel
# SSL_FAIL_URL=https://rideio-backend.vercel.app/api/v1/subscriptions/fail
# SSL_IPN_URL=https://rideio-backend.vercel.app/api/v1/subscriptions/ipn

# Admin (optional - for seed script)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
